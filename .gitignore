.DS_Store
__pycache__/
*.py[cod]
.venv/
.venv-nicegui/
.cache-nicegui/
.nicegui/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
/build/
/dist/
.env
.env.*
!.env.example

# Datos originales y derivados grandes: conservar solo referencias y notas.
/data/osm/*
!/data/osm/README.md
!/data/osm/sources.json
/outputs/*
!/outputs/.gitkeep

# Redes y resultados del piloto se generan en outputs/, nunca se versionan.
*.osm
*.osm.xml
*.osm.pbf
*.osm.gz
*.gpkg
*.gpkg.zip
*.parquet
*.net.xml
